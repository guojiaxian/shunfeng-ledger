<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动页主题（系统冷启动时展示的 windowBackground）：
         与 App 主色 #FBF9F3 一致，避免白屏→暖色的突兀跳变。
         不显示系统图标，直接过渡到 Activity 层的 Splash Overlay（Logo + App 名 + 副标题），
         确保用户只看到一个带文字的完整启动页。 -->
    <style name="Theme.Splash.ShunfengLedger" parent="Theme.SplashScreen">
        <!-- SplashScreen API 背景色：与 Overlay 同色，系统启动页直接显示 logo，避免白屏闪一下 -->
        <item name="windowSplashScreenBackground">#FBF9F3</item>
        <!-- 系统启动页直接显示 logo，首帧即见 logo，不出现纯白 -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- 图标背景（同色底），避免图标出现圆形底 -->
        <item name="windowSplashScreenIconBackgroundColor">#FBF9F3</item>
        <!-- 启动页退场后进入的主主题 -->
        <item name="postSplashScreenTheme">@style/Theme.ShunfengLedger</item>
    </style>
</resources>
